!data/real_extra/2025-02-26_16-16-54_SXC3-2323_1.jpg
!data/real_extra/2025-09-24_12-13-19_SXC3-232_1.jpg
!data/real_extra/2026-06-03_14-09-03_SXC3-2331_1.jpg
data/real_extra/*.kml

