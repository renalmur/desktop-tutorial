# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.vscode/

# Данные: полный набор снимков не хранится в репозитории
data/incoming/*.jpg
data/incoming/*.jpeg
data/incoming/*.png
data/incoming/*.tif
data/incoming/*.tiff
data/incoming/*.bmp
data/incoming/*.webp
data/incoming/README_DEMO.txt

data/saved/*
!data/saved/.gitkeep
!data/saved/README.txt

data/trash/*
!data/trash/.gitkeep
!data/trash/README.txt

data/previews/*
!data/previews/.gitkeep

# Полный набор Спутникса скачивается скриптом; в Git лежат только 3 демо-снимка
